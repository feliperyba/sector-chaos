FROM node:20-alpine

RUN corepack enable && corepack prepare pnpm@10.33.4 --activate

WORKDIR /app

COPY . .

RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

RUN pnpm --filter @sector-battle/shared build

EXPOSE 2567

HEALTHCHECK --interval=5s --timeout=3s --retries=10 --start-period=10s \
  CMD wget --no-verbose --tries=1 --spider http://localhost:2567/ || exit 1

CMD ["pnpm", "exec", "tsx", "packages/server/src/index.ts"]
