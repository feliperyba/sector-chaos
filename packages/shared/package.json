{
  "name": "@sector-battle/shared",
  "version": "0.0.1",
  "type": "module",
  "main": "src/index.ts",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "import": "./src/*/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run --pass-with-no-tests",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --config ../../oxlint.json --ignore-pattern \"**/*.test.ts\" --ignore-pattern \"**/__tests__/**\" --ignore-pattern \"**/sectors/*ArenaSkeletons.ts\" src/",
    "gallery": "tsx scripts/map-gallery.ts"
  },
  "dependencies": {
    "loglevel": "^1.9.2"
  },
  "devDependencies": {
    "oxlint": "^0.16.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
